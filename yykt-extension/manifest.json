{
  "manifest_version": 3,
  "name": "YYKT Auto Player",
  "version": "1.4",
  "description": "Auto play videos on courses.gdut.edu.cn (auto-skip PDF, suppress network-error alerts, auto-recover)",
  "content_scripts": [
    {
      "matches": ["https://courses.gdut.edu.cn/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://courses.gdut.edu.cn/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
